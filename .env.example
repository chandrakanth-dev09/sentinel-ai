# Replace the placeholder password before connecting to PostgreSQL.
DATABASE_URL=postgresql+psycopg://sentinelai:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/sentinelai
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
METRICS_RETENTION_DAYS=30
SIMULATOR_INTERVAL_SECONDS=5
MODEL_PATH=backend/models/isolation_forest.joblib

# Frontend API origin used by Vite.
VITE_API_BASE_URL=http://localhost:8000/api/v1
